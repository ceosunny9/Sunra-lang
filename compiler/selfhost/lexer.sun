# Sunra Self-Hosted Lexer (Bootstrap Step 1)

fn is_alpha(c: Str) -> Bool {
  return c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
}

fn is_digit(c: Str) -> Bool {
  return c >= "0" and c <= "9"
}

fn tokenize_source(chars: List) -> List {
  let tokens = []
  let len = len(chars)
  var i = 0
  var line = 1
  var col = 1

  while i < len {
    let c = chars[i]
    if c == "\n" {
      push(tokens, ["Newline", "\\n", line, col])
      i += 1
      line += 1
      col = 1
    } else {
      if c == " " or c == "\t" or c == "\r" {
        i += 1
        col += 1
      } else {
        if is_alpha(c) {
          var word = c
          let sc = col
          i += 1
          col += 1
          while i < len {
            let next_c = chars[i]
            if is_alpha(next_c) or is_digit(next_c) {
              word = word + next_c
              i += 1
              col += 1
            } else {
              i = len
            }
          }
          push(tokens, ["Ident", word, line, sc])
        } else {
          let sc = col
          i += 1
          col += 1
          push(tokens, ["Symbol", c, line, sc])
        }
      }
    }
  }
  push(tokens, ["Eof", "", line, col])
  return tokens
}

fn main() uses io {
  let sample = ["f", "n", " ", "s", "p", "i", "n"]
  let toks = tokenize_source(sample)
  print("Self-hosted lexer tokens:", len(toks))
}
