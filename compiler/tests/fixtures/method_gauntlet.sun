# Method gauntlet — a game-shaped program that exercises every builtin method the
# backends lower, so a gap in LLVM, Cranelift or SunVM shows up as a wrong number
# rather than as an artifact nobody inspected.
#
# Everything here is deterministic: no RNG, no clock. The expected output is
# asserted by tests/method_gauntlet.test.mjs against the interpreter and SunVM.

# --- list operations ---------------------------------------------------------

fn stripTotal(strip) -> Int {
    return strip.len()
}

fn firstAndLast(strip) -> Str {
    return strip.first() + "|" + strip.last()
}

fn withWild(strip) {
    return strip.push("WILD")
}

fn withoutTail(strip) {
    return strip.pop()
}

fn symbolRuns(strip, symbol) -> Int {
    return strip.count(symbol)
}

fn hasSymbol(strip, symbol) -> Bool {
    return strip.contains(symbol)
}

fn positionOf(strip, symbol) -> Int {
    return strip.indexOf(symbol)
}

fn window(strip, start, stop) {
    return strip.slice(start, stop)
}

fn merged(left, right) {
    return left.concat(right)
}

fn mirrored(strip) {
    return strip.reverse()
}

fn leading(strip, n) {
    return strip.take(n)
}

fn rendered(strip) -> Str {
    return strip.join("-")
}

fn payTotal(payouts) -> Int {
    return payouts.sum()
}

# --- string operations ------------------------------------------------------

fn label(name) -> Str {
    return name.trim().upper()
}

fn quiet(name) -> Str {
    return name.lower()
}

fn nameLength(name) -> Int {
    return name.len()
}

fn parts(line, sep) {
    return line.split(sep)
}

fn letters(word) {
    return word.chars()
}

fn describe(count) -> Str {
    return count.toString()
}

# --- numeric operations -----------------------------------------------------

fn swing(delta) -> Int {
    return delta.abs()
}

fn credits(amount) -> Int {
    return amount.floor()
}

fn nearest(amount) -> Int {
    return amount.round()
}

# --- nested loops and method chains -----------------------------------------

# Count matching symbols across a 3x3 grid: nested iteration plus a method call
# on an inner list, which is where a receiver-typing bug shows up.
fn gridMatches(grid, symbol) -> Int {
    var total = 0
    var row = 0
    while row < grid.len() {
        let cells = grid[row]
        var col = 0
        while col < cells.len() {
            if cells[col] == symbol {
                total = total + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    return total
}

# A chain of four method calls, each consuming the previous result.
fn chain(strip) -> Str {
    return strip.reverse().take(3).join(",").upper()
}

game MethodGauntlet {
    rtp = 96.5
    bet = 1.0
    jurisdiction = ["MGA"]

    reel strip = ["A", "K", "Q", "J", "A"]

    fn evaluate() -> Int {
        return strip.count("A")
    }

    # Deterministic by design: the fixture asserts exact output, so the "spin"
    # resolves the fixed strip rather than drawing from RNG. It exists so the game
    # block satisfies the RTP-verifiability rule.
    fn spin() -> Float {
        let aces = strip.count("A")
        return float(aces) * 0.5
    }
}

fn main() uses io {
    let strip = ["A", "K", "Q", "J", "A"]
    let payouts = [10, 20, 30]
    let grid = [["A", "K", "A"], ["Q", "A", "J"], ["K", "Q", "A"]]

    # Interpolation holds no string literals of its own: the lexer ends the outer
    # literal at the first inner quote, so every string argument is bound first.
    let ace = "A"
    let queen = "Q"
    let jack = "J"
    let dash = "-"
    let comma = ","
    let padded = "  solar fortune  "
    let shouty = "SOLAR"
    let name = "Solar"
    let csv = "a,b,c"
    let word = "Sun"

    let lenValue = stripTotal(strip)
    let endsValue = firstAndLast(strip)
    let pushValue = withWild(strip).len()
    let popValue = withoutTail(strip).len()
    let countValue = symbolRuns(strip, ace)
    let containsValue = hasSymbol(strip, queen)
    let indexValue = positionOf(strip, jack)
    let sliceValue = window(strip, 1, 3).join(dash)
    let concatValue = merged(strip, payouts).len()
    let reverseValue = mirrored(strip).join(dash)
    let takeValue = leading(strip, 2).join(dash)
    let joinValue = rendered(strip)
    let sumValue = payTotal(payouts)
    let labelValue = label(padded)
    let lowerValue = quiet(shouty)
    let strlenValue = nameLength(name)
    let splitValue = parts(csv, comma).len()
    let charsValue = letters(word).len()
    let toStringValue = describe(42)
    let absValue = swing(-7)
    let floorValue = credits(3.7)
    let roundValue = nearest(3.5)
    let gridValue = gridMatches(grid, ace)
    let chainValue = chain(strip)

    print("len          {lenValue}")
    print("ends         {endsValue}")
    print("push         {pushValue}")
    print("pop          {popValue}")
    print("count        {countValue}")
    print("contains     {containsValue}")
    print("indexOf      {indexValue}")
    print("slice        {sliceValue}")
    print("concat       {concatValue}")
    print("reverse      {reverseValue}")
    print("take         {takeValue}")
    print("join         {joinValue}")
    print("sum          {sumValue}")
    print("label        {labelValue}")
    print("lower        {lowerValue}")
    print("strlen       {strlenValue}")
    print("split        {splitValue}")
    print("chars        {charsValue}")
    print("toString     {toStringValue}")
    print("abs          {absValue}")
    print("floor        {floorValue}")
    print("round        {roundValue}")
    print("grid         {gridValue}")
    print("chain        {chainValue}")
}
